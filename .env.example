# SPDX-License-Identifier: MIT
# Every setting phonehands reads from the environment. Copy to .env and edit;
# .env is git-ignored. Placeholders only: never commit real hosts, keys or tokens.

# --- agent <-> phone relay (Android helper, packages/android-backend) ---
PHONEHANDS_RELAY_URL=ws://127.0.0.1:9011/phonehands-android
# direct | ssh-tunnel | tailscale | usb (inferred from the URL when unset)
PHONEHANDS_RELAY_PATH=

# --- iOS device engine (packages/device-backend): loopback WDA only ---
PHONEHANDS_WDA_URL=http://127.0.0.1:8100

# --- write tools (adapters/hinge): comma-separated allowlist, empty = none ---
HINGE_ALLOWED_WRITE_TOOLS=

# --- build time: 1 = compile a read-only core (no write-tier actions) ---
PHONEHANDS_READ_ONLY=0

# --- scripts/remote-topology/setup.sh ---
PHONEHANDS_TUNNEL_MODE=auto
PHONEHANDS_WDA_PORT=8100
PHONEHANDS_WDA_DIR=
PHONEHANDS_ENDPOINT_FILE=
PHONEHANDS_MOCK_TUNNEL_PORT=18100
PHONEHANDS_SSH_TUNNEL_HOST=user@relay.example.com
PHONEHANDS_SSH_TUNNEL_PORT=18100
PHONEHANDS_SSH_TUNNEL_BIND=127.0.0.1
PHONEHANDS_HEADSCALE_URL=https://headscale.example.com
PHONEHANDS_HEADSCALE_USER=phonehands
PHONEHANDS_HEADSCALE_INSTALL=0
PHONEHANDS_HEADSCALE_VERSION=
PHONEHANDS_HEADSCALE_SHA256=

# --- examples/android-wireless-demo (CI / local e2e) ---
ANDROID_SERIAL=
PHONEHANDS_E2E_PORT=9011
